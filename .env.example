# Qualificador de Leads Inteligente — variáveis de ambiente. Copie para .env.local e preencha. NUNCA versione .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Jamais usar prefixo NEXT_PUBLIC_ nesta variável. (O sistema não a usa no navegador nem na captação pública.)
SUPABASE_SERVICE_ROLE_KEY=

# IA opcional — análise textual de leads, SEPARADA do score. O sistema funciona sem estas variáveis.
# Qualquer API compatível com "chat completions" (OpenAI, OpenRouter, gateway próprio, servidor local).
# AI_BASE_URL precisa ser https:// (http:// só para localhost). A chave fica SOMENTE no servidor.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Nome exibido no histórico da análise (opcional; padrão: o domínio de AI_BASE_URL)
AI_PROVIDER=
